---
interface Props {
  title: string;
  description: string;
  icon: 'automation' | 'hosting' | 'growth';
}

const { title, description, icon } = Astro.props;
const icons: Record<string, string> = {
  automation: '/images/icon-automation-1024.svg',
  hosting: '/images/icon-hosting-1024.svg',
  growth: '/images/icon-growth-1024.svg',
};
---

<article class="rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
  <img src={icons[icon] ?? icons.automation} alt="" class="h-16 w-16 object-contain" width="64" height="64" />
  <h3 class="mt-4 text-lg font-semibold text-slate-900">{title}</h3>
  <p class="mt-2 text-slate-600">{description}</p>
</article>
