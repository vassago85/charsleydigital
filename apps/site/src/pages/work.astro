---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CTABlock from '../components/CTABlock.astro';
import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'work');
if (!page) throw new Error('Work page not found');
const { title, description, hero, sections = [], cta } = page.data;
---

<BaseLayout title={title} description={description}>
  <Hero headline={hero.headline} subheadline={hero.subheadline} />
  {sections.map((s: { type?: string; items?: { title: string; description: string; status: string }[] }) => {
    if (s.type === 'case_studies' && s.items) {
      return (
        <Section>
          <div class="space-y-8">
            {s.items.map((item: { title: string; description: string; status: string }) => (
              <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                  <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
                  <span class="rounded-full bg-teal-100 px-3 py-1 text-sm text-teal-700">{item.status}</span>
                </div>
                <p class="mt-2 text-slate-600">{item.description}</p>
              </article>
            ))}
          </div>
        </Section>
      );
    }
    return null;
  })}
  {cta && <CTABlock title={cta.title} buttonText={cta.buttonText} />}
</BaseLayout>
