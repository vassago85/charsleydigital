---
interface Props {
  title: string;
  description?: string;
  buttonText: string;
  href?: string;
}

const { title, description, buttonText, href = '/contact' } = Astro.props;
---

<section class="bg-teal-600 py-16 text-white">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <h2 class="text-2xl font-semibold">{title}</h2>
    {description && <p class="mt-2 text-teal-100">{description}</p>}
    <a
      href={href}
      class="mt-6 inline-block rounded-md border-2 border-white px-6 py-3 font-medium hover:bg-white hover:text-teal-600 transition-colors"
    >
      {buttonText}
    </a>
  </div>
</section>
