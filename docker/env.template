# Charsley Digital - Production Environment
# Copy this to /opt/charsleydigital/.env and fill in the values

# App Key - generate with: docker compose exec app php artisan key:generate --show
APP_KEY=

# Database
DB_ROOT_PASSWORD=CHANGE_ME
DB_DATABASE=charsleydigital
DB_USERNAME=charsleydigital
DB_PASSWORD=CHANGE_ME

# URL
APP_URL=https://charsleydigital.co.za
APP_PORT=8086

# Admin user (used on first deploy seed)
ADMIN_EMAIL=paul@charsley.co.za
ADMIN_PASSWORD=CHANGE_ME

# Mailgun
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS=noreply@charsleydigital.co.za
MAIL_FROM_NAME=Charsley Digital
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

# Lead notifications
LEADS_TO_EMAIL=paul@charsley.co.za

# Ntfy (optional)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
