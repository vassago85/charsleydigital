---
interface Props {
  name: string;
  description: string;
  image?: string;
  slug?: string;
}

const { name, description, image = 'product-ssmm', slug } = Astro.props;
const imgPath = image.startsWith('/') ? image : `/images/${image}-1400x900.svg`;
---

<article class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <img src={imgPath} alt="" class="h-48 w-full object-cover" width="400" height="192" />
  <div class="p-6">
    <h3 class="text-lg font-semibold text-slate-900">{name}</h3>
    <p class="mt-2 text-slate-600">{description}</p>
  </div>
</article>
