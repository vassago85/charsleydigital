---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<section class={`py-16 px-6 ${className}`}>
  <div class="mx-auto max-w-4xl">
    {title && <h2 class="mb-10 text-2xl font-semibold text-slate-900">{title}</h2>}
    <slot />
  </div>
</section>
