---
const apiBase = import.meta.env.PUBLIC_API_BASE || 'http://charsleydigital.test';
---

<form
  id="lead-form"
  action={`${apiBase}/api/leads`}
  method="POST"
  class="space-y-6"
  data-api-base={apiBase}
>
  <input type="hidden" name="timestamp" id="form-timestamp" value="" />
  <div class="hidden" aria-hidden="true">
    <label for="website_url">Leave blank</label>
    <input type="text" name="website_url" id="website_url" tabindex="-1" autocomplete="off" />
  </div>
  <div>
    <label for="org_name" class="block text-sm font-medium text-slate-700">Organisation name *</label>
    <input type="text" name="org_name" id="org_name" required class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500" />
  </div>
  <div>
    <label for="contact_name" class="block text-sm font-medium text-slate-700">Your name *</label>
    <input type="text" name="contact_name" id="contact_name" required class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500" />
  </div>
  <div>
    <label for="role_title" class="block text-sm font-medium text-slate-700">Role / title</label>
    <input type="text" name="role_title" id="role_title" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500" />
  </div>
  <div>
    <label for="email" class="block text-sm font-medium text-slate-700">Email *</label>
    <input type="email" name="email" id="email" required class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500" />
  </div>
  <div>
    <label for="phone" class="block text-sm font-medium text-slate-700">Phone</label>
    <input type="tel" name="phone" id="phone" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500" />
  </div>
  <div>
    <label for="system_type" class="block text-sm font-medium text-slate-700">What type of system? *</label>
    <select name="system_type" id="system_type" required class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500">
      <option value="">Select...</option>
      <option value="membership_portal">Membership portal</option>
      <option value="admin_portal">Admin portal</option>
      <option value="ecommerce">E-commerce</option>
      <option value="custom_webapp">Custom web application</option>
      <option value="website">Marketing website</option>
      <option value="other">Other</option>
    </select>
  </div>
  <div>
    <label for="problem_description" class="block text-sm font-medium text-slate-700">Describe your needs *</label>
    <textarea name="problem_description" id="problem_description" rows="4" required class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500"></textarea>
  </div>
  <fieldset>
    <legend class="block text-sm font-medium text-slate-700">Who will use the system?</legend>
    <div class="mt-2 space-y-2">
      <label class="inline-flex items-center gap-2">
        <input type="checkbox" name="users_admins" value="1" />
        <span>Admins</span>
      </label>
      <label class="ml-4 inline-flex items-center gap-2">
        <input type="checkbox" name="users_staff" value="1" />
        <span>Staff</span>
      </label>
      <label class="ml-4 inline-flex items-center gap-2">
        <input type="checkbox" name="users_members" value="1" />
        <span>Members</span>
      </label>
      <label class="ml-4 inline-flex items-center gap-2">
        <input type="checkbox" name="users_public" value="1" />
        <span>Public</span>
      </label>
    </div>
    <div class="mt-2">
      <label for="users_other" class="block text-sm text-slate-600">Other (describe)</label>
      <input type="text" name="users_other" id="users_other" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm" />
    </div>
  </fieldset>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <label for="active_users_est" class="block text-sm font-medium text-slate-700">Est. active users</label>
      <input type="number" name="active_users_est" id="active_users_est" min="0" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm" />
    </div>
    <div>
      <label for="monthly_transactions_est" class="block text-sm font-medium text-slate-700">Est. monthly transactions</label>
      <input type="number" name="monthly_transactions_est" id="monthly_transactions_est" min="0" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm" />
    </div>
  </div>
  <div>
    <label for="storage_est" class="block text-sm font-medium text-slate-700">Storage needs (estimate)</label>
    <input type="text" name="storage_est" id="storage_est" placeholder="e.g. 10GB, documents + images" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm" />
  </div>
  <div>
    <label for="timeline" class="block text-sm font-medium text-slate-700">Timeline *</label>
    <select name="timeline" id="timeline" required class="mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500">
      <option value="">Select...</option>
      <option value="urgent">Urgent (within 1 month)</option>
      <option value="1-3_months">1–3 months</option>
      <option value="3-6_months">3–6 months</option>
      <option value="6_plus_months">6+ months</option>
      <option value="exploring">Just exploring</option>
    </select>
  </div>
  <div>
    <label for="budget_expectation" class="block text-sm font-medium text-slate-700">Budget expectations</label>
    <input type="text" name="budget_expectation" id="budget_expectation" placeholder="e.g. ballpark, range" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm" />
  </div>
  <div>
    <label class="inline-flex items-center gap-2">
      <input type="checkbox" name="consent" value="1" required />
      <span class="text-sm text-slate-700">I agree to be contacted about this enquiry *</span>
    </label>
  </div>
  <div id="form-message" class="hidden rounded-md p-4 text-sm"></div>
  <button type="submit" id="form-submit" class="rounded-md bg-teal-600 px-6 py-2 font-medium text-white hover:bg-teal-700 focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 disabled:opacity-50">
    Submit enquiry
  </button>
</form>

<script define:vars={{ apiBase }}>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('lead-form');
    const msg = document.getElementById('form-message');
    const submitBtn = document.getElementById('form-submit');
    const tsInput = document.getElementById('form-timestamp');
    const honeypot = document.getElementById('website_url');

    if (!tsInput) return;
    tsInput.value = String(Date.now());

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !msg) return;
      submitBtn.disabled = true;
      msg.classList.add('hidden');

      const formData = new FormData(form);
      const honeypotValue = honeypot?.value;
      if (honeypotValue) {
        msg.textContent = 'Unable to submit. Please try again.';
        msg.classList.remove('hidden');
        msg.classList.add('bg-red-100', 'text-red-700');
        submitBtn.disabled = false;
        return;
      }

      const body = Object.fromEntries(formData.entries());
      body.users_admins = formData.has('users_admins') ? '1' : '0';
      body.users_staff = formData.has('users_staff') ? '1' : '0';
      body.users_members = formData.has('users_members') ? '1' : '0';
      body.users_public = formData.has('users_public') ? '1' : '0';
      body.consent = formData.has('consent') ? '1' : '0';

      try {
        const res = await fetch(`${apiBase}/api/leads`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          msg.textContent = 'Thank you. We\'ll be in touch within one business day.';
          msg.classList.remove('hidden', 'bg-red-100', 'text-red-700');
          msg.classList.add('bg-teal-100', 'text-teal-800');
          form.reset();
        } else {
          msg.textContent = data.message || data.errors ? Object.values(data.errors || {}).flat().join(' ') : 'Something went wrong. Please try again.';
          msg.classList.remove('hidden', 'bg-teal-100', 'text-teal-800');
          msg.classList.add('bg-red-100', 'text-red-700');
        }
      } catch {
        msg.textContent = 'Unable to submit. Please try again or email us directly.';
        msg.classList.remove('hidden', 'bg-teal-100', 'text-teal-800');
        msg.classList.add('bg-red-100', 'text-red-700');
      }
      submitBtn.disabled = false;
    });
  });
</script>
